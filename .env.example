# ANTHROPIC_API_KEY: clave de Claude (Anthropic) para el asistente de IA. Solo en el servidor.
# Se crea en la Consola de Claude. Sin ella, el análisis y el chat no responden.
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"

# APP_URL: origen de la app. En local es http://localhost:3001.
APP_URL="http://localhost:3001"

# Firebase web del proyecto cyclia-mvp.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="cyclia-mvp.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cyclia-mvp"
VITE_FIREBASE_STORAGE_BUCKET="cyclia-mvp.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="535794788501"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

