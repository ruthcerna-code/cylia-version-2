# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: origen de la app. En local es http://localhost:3001.
APP_URL="http://localhost:3001"

# Firebase web del proyecto cyclia-mvp.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="cyclia-mvp.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cyclia-mvp"
VITE_FIREBASE_STORAGE_BUCKET="cyclia-mvp.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="535794788501"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Gmail que envía la clave provisoria. Usa una contraseña de aplicación, no la clave de la cuenta.
GMAIL_USER="tu-cuenta@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
